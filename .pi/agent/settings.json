{
  "lastChangelogVersion": "1.0.3",
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-v4-flash",
  "enabledModels": [
    "mlx/**",
    "lmstudio/*",
    "deepseek/*",
    "zai-coding-cn/*",
    "openai/gpt-6.1-*"
