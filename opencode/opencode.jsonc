{
  "$schema": "https://opencode.ai/config.json",
  "worktree": {
    "directory": "~/Files/worktrees"
  },
  "policies": [
    { "action": "provider.use", "resource": "kimi-code-plan-global", "effect": "deny" },
    { "action": "provider.use", "resource": "minimax", "effect": "deny" },
    { "action": "provider.use", "resource": "minimax-cn", "effect": "deny" },
    { "action": "provider.use", "resource": "minimax-coding-plan", "effect": "deny" },
    { "action": "provider.use", "resource": "minimax-cn-coding-plan", "effect": "deny" }
  ],
  "providers": {
    "omlx": {
      "name": "oMLX (192.168.2.10)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://192.168.2.10:8000/v1",
        "apiKey": "{file:~/.local/share/opencode/secrets/omlx-192.168.2.10.key}"
      },
      "models": {
        "Qwen3.8-27B-Uncensored-Code-Splash": {
          "name": "Qwen3.8 27B Uncensored · Code Splash",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "reasoning": { "supported": true }
          },
          "compatibility": {
            "reasoningField": "reasoning_content",
            "maxTokensField": "max_tokens"
          },
          "limit": { "context": 73728, "output": 8192 }
        },
        "Qwen3.8-27B-Uncensored-Daily-MTP": {
          "name": "Qwen3.8 27B Uncensored · Daily MTP",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "reasoning": { "supported": true }
          },
          "compatibility": {
            "reasoningField": "reasoning_content",
            "maxTokensField": "max_tokens"
          },
          "limit": { "context": 40960, "output": 8192 }
        }
      }
    },
    "openai": {
      "models": {
        "chatgpt-image-latest": { "disabled": true },
        "gpt-4.1": { "disabled": true },
        "gpt-4.1-fast": { "disabled": true },
        "gpt-4.1-mini": { "disabled": true },
        "gpt-4.1-mini-fast": { "disabled": true },
        "gpt-4o": { "disabled": true },
        "gpt-4o-2024-08-06": { "disabled": true },
