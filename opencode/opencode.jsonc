          "name": "claude-fable-5-2",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "gpt-6.2-astra": {
          "modelID": "gpt-6.2-astra",
          "name": "gpt-6.2-astra",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
