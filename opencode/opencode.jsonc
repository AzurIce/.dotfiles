        "gpt-4o-fast": { "disabled": true },
        "gpt-4o-mini": { "disabled": true },
        "gpt-4o-mini-fast": { "disabled": true },
        "gpt-5": { "disabled": true },
        "gpt-5-fast": { "disabled": true },
        "gpt-5-flex": { "disabled": true },
        "gpt-5-mini": { "disabled": true },
        "gpt-5-mini-fast": { "disabled": true },
        "gpt-5-mini-flex": { "disabled": true },
        "gpt-5-nano": { "disabled": true },
