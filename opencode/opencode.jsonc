        },
        "gpt-image-2.6": {
          "modelID": "gpt-image-2.6",
          "name": "GPT Image 2.6",
          "type": "image",
          "package": "aisdk:@opencode/ai/providers/openai/images",
          "settings": {
            "baseURL": "https://www.poke2api.com/v1"
          },
          "capabilities": {
            "tools": false,
            "input": ["text", "image"],
            "output": ["image"]
          }
        },
        "claude-opus-5-5": {
          "modelID": "claude-opus-5-5",
          "name": "claude-opus-5-5",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "gpt-6-astra": {
          "modelID": "gpt-6-astra",
          "name": "gpt-6-astra",
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        },
        "gpt-6.1-sol": {
          "modelID": "gpt-6.1-sol",
          "name": "gpt-6.1-sol",
