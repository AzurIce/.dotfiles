    "poke": {
      "name": "PokeAPI",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "https://www.poke2api.com"
      },
      "models": {
        "gpt-image-2": {
          "modelID": "gpt-image-2",
          "name": "GPT Image 2",
          "type": "image",
          "package": "aisdk:@opencode/ai/providers/openai/images",
          "settings": {
            "baseURL": "https://www.poke2api.com/v1"
          },
          "capabilities": {
            "tools": false,
            "input": ["text", "image"],
            "output": ["image"]
          }
        },
        "gpt-image-2.5-sunburst": {
          "modelID": "gpt-image-2.5-sunburst",
          "name": "GPT Image 2.5 Sunburst",
          "type": "image",
          "package": "aisdk:@opencode/ai/providers/openai/images",
          "settings": {
            "baseURL": "https://www.poke2api.com/v1"
          },
          "capabilities": {
            "tools": false,
            "input": ["text", "image"],
            "output": ["image"]
          }
        },
        "gpt-image-2.5-flare": {
